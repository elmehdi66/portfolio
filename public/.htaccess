Options -Indexes
DirectorySlash On
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS et domaine sans www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.gazry\.dev [NC]
  RewriteRule ^(.*)$ https://gazry.dev/$1 [L,R=301]

  # Anciennes URL du site précédent
  RewriteRule ^developpeur-web-freelance-casablanca\.html$ /developpeur-web-freelance-casablanca/ [L,R=301]
  RewriteRule ^old\.html$ / [L,R=301]
  RewriteRule ^index\.html$ / [L,R=301]
  RewriteRule ^(README\.md|styles\.css)$ / [L,R=301]

  # Barre oblique finale pour les pages (ex. /services -> /services/)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# Pas d'accès aux fichiers cachés (.git, .env…)
<IfModule mod_rewrite.c>
  RewriteRule (^|/)\.(?!well-known) - [F]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Fichiers versionnés par le build (/_astro/) : cache long et immuable
  SetEnvIf Request_URI "^/_astro/" GZ_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=GZ_ASSET
  # Images, polices et icônes non versionnées : 1 semaine
  <FilesMatch "\.(woff2|avif|webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800" env=!GZ_ASSET
  </FilesMatch>
  # Pages HTML et fichiers texte : revalidation à chaque visite
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain application/manifest+json
</IfModule>

AddType application/manifest+json .webmanifest
