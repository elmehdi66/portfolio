---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { src, alt, sizes = '(min-width: 1100px) 300px, 42vw', eager = false, class: cls } = Astro.props;
const widths = [320, 480, 640, 780].filter((w) => w <= src.width);
---
<figure class:list={['phone', cls]}>
  <Picture
    src={src}
    alt={alt}
    widths={widths.length ? widths : [src.width]}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    quality={74}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
</figure>

<style>
  .phone :global(img) { aspect-ratio: 390 / 844; object-fit: cover; object-position: top center; }
</style>
