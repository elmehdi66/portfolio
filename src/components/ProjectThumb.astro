---
import { Picture } from 'astro:assets';
import type { Project } from '../data/types';

interface Props { project: Project; index: number; eager?: boolean }
const { project: p, index, eager = false } = Astro.props;
---
<a class="pt" href={`/realisations/${p.slug}/`}>
  <span class="pt__img" style={p.tint ? `--tint:${p.tint}` : undefined}>
    <Picture
      src={p.cover.src}
      alt=""
      widths={[360, 540, 720, 960].filter((w) => w <= p.cover.src.width)}
      sizes="(min-width: 1100px) 23vw, (min-width: 640px) 46vw, 80vw"
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={70}
      loading={eager ? 'eager' : 'lazy'}
    />
  </span>
  <span class="pt__meta">
    <span class="pt__n mono">{String(index).padStart(2, '0')}</span>
    <span class="pt__name">{p.name}</span>
    <span class="pt__kind mono">{p.kind}</span>
  </span>
</a>

<style>
  .pt { display: grid; gap: 0.85rem; }
  .pt__img {
    --tint: var(--paper-2);
    display: block; aspect-ratio: 4 / 3; border-radius: 10px; overflow: hidden; background: var(--tint);
    padding: 7% 7% 0; border: 1px solid var(--line);
  }
  .pt__img :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: top left; border-radius: 6px 6px 0 0;
    box-shadow: 0 10px 30px -14px rgb(20 19 17 / 0.45); transition: transform 0.8s var(--ease-out);
  }
  .pt:hover .pt__img :global(img) { transform: translateY(-4px) scale(1.015); }
  .pt__meta { display: grid; grid-template-columns: auto 1fr; column-gap: 0.75rem; row-gap: 0.15rem; align-items: baseline; }
  .pt__n { color: var(--clay); font-size: 0.6875rem; }
  .pt__name { font-family: var(--f-display); font-weight: 600; font-size: 1.25rem; letter-spacing: -0.02em; }
  .pt__kind { grid-column: 2; color: var(--ink-3); font-size: 0.6875rem; }
  .pt:hover .pt__name { color: var(--clay-ink); }
</style>
