---
// Jeu d'icônes inline minimal (traits 1.5px), hérite de currentColor.
interface Props {
  name: 'arrow' | 'arrow-down' | 'external' | 'whatsapp' | 'mail' | 'phone' | 'linkedin' | 'copy' | 'check' | 'menu' | 'close' | 'pin' | 'clock';
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 18, class: cls, label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' as const };
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false" {...a11y}>
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'arrow-down' && <path d="M12 4v15M6 13l6 6 6-6" />}
  {name === 'external' && <path d="M7 17 17 7M9 7h8v8" />}
  {name === 'mail' && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></>)}
  {name === 'phone' && <path d="M5 4h3.5l1.6 4.2-2.2 1.4a11 11 0 0 0 6.5 6.5l1.4-2.2L20 15.5V19a1.5 1.5 0 0 1-1.6 1.5C10.6 20 4 13.4 3.5 5.6A1.5 1.5 0 0 1 5 4Z" />}
  {name === 'copy' && (<><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8" /></>)}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'menu' && <path d="M4 8h16M4 16h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'pin' && (<><path d="M12 21s-7-6.2-7-11.5a7 7 0 1 1 14 0C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></>)}
  {name === 'clock' && (<><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>)}
  {name === 'linkedin' && (<><rect x="3.5" y="3.5" width="17" height="17" rx="2.5" /><path d="M8 10.5V16M8 7.8v.01M11.5 16v-3.2c0-1.4.9-2.3 2.1-2.3s2 .9 2 2.3V16M11.5 10.5V16" /></>)}
  {name === 'whatsapp' && (<><path d="M4.5 19.5 5.6 16A8 8 0 1 1 8.4 18.6Z" /><path d="M9.3 8.6c.2-.4.5-.4.8-.4h.4c.2 0 .4.1.5.4l.6 1.4c.1.2 0 .5-.1.6l-.4.5c-.1.1-.1.3 0 .5.6 1 1.4 1.7 2.4 2.2.2.1.4.1.5-.1l.5-.6c.1-.2.4-.2.6-.1l1.4.7c.2.1.3.3.3.5 0 .5-.2 1.1-.8 1.4-.6.4-1.5.4-2.7-.1-1.6-.7-3-2-3.8-3.6-.6-1.2-.6-2.3-.2-2.9Z" fill="currentColor" stroke="none" /></>)}
</svg>
