---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  url?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  /** Recadre l'image à une hauteur max (ratio largeur/hauteur), ex. 16/10 */
  ratio?: number;
  /** Sans barre de navigateur */
  bare?: boolean;
}
const { src, alt, url, sizes = '(min-width: 1440px) 1200px, 92vw', widths = [640, 960, 1280, 1600, 2200], eager = false, class: cls, ratio, bare = false } = Astro.props;
const host = url ? url.replace(/^https?:\/\//, '').replace(/\/$/, '') : '';
const usable = widths.filter((w) => w <= src.width);
---
<figure class:list={['frame', { 'frame--bare': bare }, cls]}>
  {!bare && <div class="frame__bar" aria-hidden="true">
    <span class="frame__dots"><i></i><i></i><i></i></span>
    <span class="frame__url">{host}</span>
    <span class="frame__spacer"></span>
  </div>}
  <div class="frame__view" style={ratio ? `aspect-ratio:${ratio}` : undefined}>
    <Picture
      src={src}
      alt={alt}
      widths={usable.length ? usable : [src.width]}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={72}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding={eager ? 'sync' : 'async'}
    />
  </div>
</figure>

<style>
  .frame__spacer { width: 45px; }
  .frame--bare { background: transparent; }
  .frame__view { overflow: hidden; background: var(--paper-2); }
  .frame__view :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
</style>
